# ==============================================================
# Root environment file for docker-compose
# Copy to .env and fill in values: cp .env.example .env
# ==============================================================

# --- Database ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ecourse

# --- Backend ---
# Generate a strong value, e.g. `openssl rand -hex 32`. Required in production:
# the app refuses to start when ENVIRONMENT=production and SECRET_KEY is the default.
SECRET_KEY=change-me-in-production
ENVIRONMENT=development
BACKEND_CORS_ORIGINS=http://localhost:3000

# LLM providers (Groq is default, OpenRouter is fallback).
# Set at least one key to enable AI features (course/quiz generation, chatbot,
# summaries). With none set, AI endpoints return a clear "not configured" error
# while all non-AI features keep working.
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Optional: override the model for the active provider (else provider defaults
# GROQ_MODEL / OPENROUTER_MODEL are used).
MODEL_NAME=

# Supabase (auth + storage) — optional
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
